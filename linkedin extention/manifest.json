{
  "manifest_version": 3,
  "name": "LinkedIn Outreach AI",
  "version": "4.1.0",
  "description": "Personalised LinkedIn outreach from the profile you're viewing. Side panel, one-click insert, follow-up tracker. Requires a license key.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "contextMenus",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin-extention-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Outreach AI (Alt+Shift+O)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Open the Outreach AI side panel"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
